    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text ?? $input.first().json.output ?? $input.first().json.response;\n\nlet cleaned = raw.trim();\ncleaned = cleaned.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/i, '');\n\ncleaned = cleaned.replace(/\"([^\"\\\\]|\\\\.)*\"/g, (match) => {\n  return match.replace(/\\n/g, '\\\\n').replace(/\\r/g, '\\\\r').replace(/\\t/g, '\\\\t');\n});\n\nfunction normalizeItems(parsed) {\n  let items = parsed.items ?? (Array.isArray(parsed) ? parsed : [parsed]);\n  if (typeof items === 'string') {\n    try {\n      items = JSON.parse(items);\n    } catch (e) {\n      // не смогли распарсить строку как JSON\n    }\n  }\n  return Array.isArray(items) ? items : [];\n}\n\nlet allItems = [];\n\ntry {\n  const parsed = JSON.parse(cleaned);\n  allItems = normalizeItems(parsed);\n} catch (e) {\n  const objectMatches = cleaned.match(/\\{[\\s\\S]*?\\}/g);\n\n  if (!objectMatches) {\n    throw new Error(`Не удалось найти JSON-объекты в ответе.\\n\\nRaw text (first 2000 chars):\\n${cleaned.slice(0, 2000)}`);\n  }\n\n  for (const objStr of objectMatches) {\n    try {\n      const obj = JSON.parse(objStr);\n      const objItems = normalizeItems(obj);\n      if (objItems.length) allItems.push(...objItems);\n    } catch (innerError) {\n      console.log('Skipped malformed object:', objStr.slice(0, 300), 'Error:', innerError.message);\n    }\n  }\n}\n\nif (allItems.length === 0) {\n  throw new Error(`Не удалось распарсить ни одного объекта.\\n\\nRaw text (first 3000 chars):\\n${cleaned.slice(0, 3000)}`);\n}\n\nreturn [{ json: { items: allItems } }];"
      },
