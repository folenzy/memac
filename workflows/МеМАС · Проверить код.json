    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst body = $('Вход: код').first().json.body;\n\nlet execStatus = 'not_run';\nlet execOutput = '';\nlet llmReview = '';\n\nif (j.status) {\n  execStatus = j.status;\n  execOutput = String(j.output || '');\n  if (j.rows) execOutput += ' | ' + JSON.stringify(j.rows).slice(0, 500);\n} else {\n  let raw = '';\n  for (const v of Object.values(j)) {\n    if (typeof v === 'string' && v.length > raw.length) raw = v;\n  }\n  const s = raw.indexOf('{');\n  const e = raw.lastIndexOf('}');\n  if (s !== -1 && e > s) {\n    try {\n      const p = JSON.parse(raw.slice(s, e + 1));\n      execStatus = p.verdict === 'passed' ? 'passed' : 'failed';\n      llmReview = String(p.review || '');\n    } catch (err) {\n      execStatus = 'error';\n      llmReview = raw.slice(0, 300);\n    }\n  }\n}\n\nreturn [{ json: {\n  session_id:  Number(body.session_id),\n  task_id:     Number(body.task_id),\n  code:        String(body.code).replace(/'/g, \"''\"),\n  timeline:    JSON.stringify(body.timeline || []).replace(/'/g, \"''\"),\n  exec_status: execStatus,\n  exec_output: execOutput.replace(/'/g, \"''\"),\n  llm_review:  llmReview.replace(/'/g, \"''\")\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
