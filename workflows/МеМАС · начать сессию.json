        "postgres": {
          "id": "KSlL0XgJe9oa85ah",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet b = raw.body;\nif (!b) b = raw;\n\nlet t = String(b.token || '');\nt = t.replace(/[^a-f0-9]/gi, '');\nt = t.slice(0, 64);\n\nreturn [{ json: { token: t } }];"
      },
      "type": "n8n-nodes-base.code",
