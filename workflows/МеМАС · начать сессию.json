    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE \"ASiruk\".interview_sessions\nSET status     = 'in_progress',\n    started_at = coalesce(started_at, now())\nWHERE id = {{ $json.session_id }}\nRETURNING id AS session_id, started_at;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
