          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst meta = $('1. Проверить токен').first().json;\n\nif (rows.length === 0) {\n  return [{ json: { ok: false, error: 'empty_playlist', session_id: meta.session_id } }];\n}\n\nlet withVideo = 0;\nfor (const r of rows) {\n  if (r.video_path) withVideo = withVideo + 1;\n}\n\nreturn [{ json: {\n  ok:            true,\n  session_id:    meta.session_id,\n  employee_name: meta.employee_name,\n  is_training:   meta.is_training,\n  duration_min:  meta.duration_min,\n  total:         rows.length,\n  with_video:    withVideo,\n  questions:     rows\n}}];"
      },
