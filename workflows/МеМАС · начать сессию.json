    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT sq.order_no,\n       sq.question_id,\n       sq.competency_id,\n       q.question_text,\n       q.question_type,\n       c.name  AS competency_name,\n       c.kind  AS competency_kind,\n       m.video_path,\n       m.audio_path,\n       m.duration_sec\nFROM \"ASiruk\".session_questions sq\nJOIN \"ASiruk\".interview_questions q ON q.id = sq.question_id\nLEFT JOIN \"ASiruk\".competencies c   ON c.id = sq.competency_id\nLEFT JOIN \"ASiruk\".media_assets m   ON m.question_id = sq.question_id\nWHERE sq.session_id = {{ $json.session_id }}\nORDER BY sq.order_no;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
