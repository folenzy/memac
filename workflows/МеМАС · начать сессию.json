    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.token,\n       r.id          AS room_id,\n       r.session_id,\n       r.role,\n       s.status      AS session_status,\n       s.employee_id,\n       s.is_training,\n       s.duration_min,\n       u.full_name   AS employee_name,\n       CASE\n         WHEN r.id IS NULL             THEN 'not_found'\n         WHEN r.expires_at <= now()    THEN 'expired'\n         WHEN s.status = 'completed'   THEN 'already_done'\n         ELSE 'ok'\n       END AS check_result\nFROM (SELECT '{{ $json.token }}'::text AS token) t\nLEFT JOIN \"ASiruk\".rooms r              ON r.token = t.token\nLEFT JOIN \"ASiruk\".interview_sessions s ON s.id = r.session_id\nLEFT JOIN \"ASiruk\".users u              ON u.id = s.employee_id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
