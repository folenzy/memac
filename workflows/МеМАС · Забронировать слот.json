    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.slot_id, t.session_id,\n       s.status      AS slot_status,\n       s.starts_at,\n       s.or_id       AS slot_or_id,\n       ses.or_id     AS session_or_id,\n       ses.status    AS session_status,\n       ses.employee_id,\n       CASE\n         WHEN s.id IS NULL                          THEN 'slot_not_found'\n         WHEN ses.id IS NULL                        THEN 'session_not_found'\n         WHEN s.status <> 'free'                    THEN 'slot_busy'\n         WHEN s.starts_at <= now()                  THEN 'slot_in_past'\n         WHEN ses.status <> 'planned'               THEN 'session_not_planned'\n         WHEN s.or_id IS DISTINCT FROM ses.or_id    THEN 'or_mismatch'\n         ELSE 'ok'\n       END AS check_result\nFROM (SELECT {{ $json.body.slot_id }}::int AS slot_id,\n             {{ $json.body.session_id }}::int AS session_id) t\nLEFT JOIN \"ASiruk\".slots s                ON s.id = t.slot_id\nLEFT JOIN \"ASiruk\".interview_sessions ses ON ses.id = t.session_id;",
        "options": {}
      },
