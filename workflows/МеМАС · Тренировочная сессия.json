      "name": "Вход: тренировка",
      "webhookId": "8a2c7de3-5bf3-41c6-9310-e3247d673d6d"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT coalesce(string_agg(t.id::text, ','), '') AS competency_ids_sql,\n       count(*) AS cnt\nFROM (\n  SELECT c.id\n  FROM \"ASiruk\".employee_competencies ec\n  JOIN \"ASiruk\".competencies c ON c.id = ec.competency_id\n  WHERE ec.employee_id = {{ $json.body.employee_id }}\n    AND ec.status <> 'confirmed'\n    AND EXISTS (SELECT 1 FROM \"ASiruk\".interview_questions q\n                WHERE q.competency_id = c.id AND q.status = 'approved')\n  ORDER BY random()\n  LIMIT 3\n) t;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        112,
        -176
      ],
      "id": "56e9ed9c-aad5-4fe3-8bf5-433713aef492",
      "name": "1. Подобрать компетенции",
      "credentials": {
        "postgres": {
          "id": "KSlL0XgJe9oa85ah",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"ASiruk\".interview_sessions\n    (employee_id, or_id, duration_min, is_training, status)\nVALUES ({{ $('Вход: тренировка').first().json.body.employee_id }},\n        NULL,\n        {{ $('Вход: тренировка').first().json.body.duration_min || 20 }},\n        true, 'planned')\nRETURNING id AS session_id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        368,
        -192
      ],
      "id": "e5e00068-3454-4dd5-8fdf-1fb53074598a",
      "name": "2. Создать сессию",
      "credentials": {
        "postgres": {
          "id": "KSlL0XgJe9oa85ah",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (\n  INSERT INTO \"ASiruk\".session_competencies (session_id, competency_id)\n  SELECT {{ $json.session_id }},\n         unnest(ARRAY[{{ $('1. Подобрать компетенции').first().json.competency_ids_sql }}]::int[])\n  ON CONFLICT DO NOTHING\n  RETURNING 1\n)\nSELECT {{ $json.session_id }} AS session_id, (SELECT count(*) FROM ins) AS linked;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        512,
        16
      ],
      "id": "c99c8f50-0973-4854-be20-7f54682f31eb",
      "name": "3. Привязать компетенции",
      "credentials": {
        "postgres": {
          "id": "KSlL0XgJe9oa85ah",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT question_id, competency_id\nFROM (\n  SELECT q.id AS question_id, q.competency_id,\n         row_number() OVER (PARTITION BY q.competency_id ORDER BY random()) AS rn\n  FROM \"ASiruk\".interview_questions q\n  WHERE q.competency_id = ANY(ARRAY[{{ $('1. Подобрать компетенции').first().json.competency_ids_sql }}]::int[])\n    AND q.status = 'approved'\n) t\nWHERE rn <= 2\nORDER BY competency_id, rn;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        672,
        -192
      ],
      "id": "58a7e5fc-a36a-403f-8bd0-d5a21e6bfb14",
      "name": "4. Отобрать вопросы",
      "credentials": {
        "postgres": {
          "id": "KSlL0XgJe9oa85ah",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const byComp = {};\nfor (const it of $input.all()) {\n  const k = it.json.competency_id;\n  if (!byComp[k]) byComp[k] = [];\n  byComp[k].push(it.json);\n}\nconst keys = Object.keys(byComp);\nconst ordered = [];\nlet idx = 0, more = true;\nwhile (more) {\n  more = false;\n  for (const k of keys) {\n    if (byComp[k][idx]) { ordered.push(byComp[k][idx]); more = true; }\n  }\n  idx++;\n}\nif (ordered.length === 0) throw new Error('Нет вопросов');\n\nconst sessionId = $('3. Привязать компетенции').first().json.session_id;\nreturn ordered.map((o, i) => ({ json: {\n  session_id: sessionId, question_id: o.question_id,\n  competency_id: o.competency_id, order_no: i + 1\n}}));"
      },
