        "query": "SELECT t.session_id, t.level,\n       CASE\n         WHEN s.id IS NULL                                              THEN 'not_found'\n         WHEN t.role = 'or'       AND s.or_id IS DISTINCT FROM t.uid    THEN 'not_owner'\n         WHEN t.role = 'employee' AND s.employee_id IS DISTINCT FROM t.uid THEN 'not_yours'\n         WHEN t.role = 'employee' AND t.level <> 3                      THEN 'level_forbidden'\n         ELSE 'ok'\n       END AS check_result\nFROM (SELECT {{ $json.body.session_id }}::int AS session_id,\n             {{ $json.body.level }}::int AS level,\n             {{ $json.body.requester_id }}::int AS uid,\n             '{{ $json.body.role }}'::text AS role) t\nLEFT JOIN \"ASiruk\".interview_sessions s ON s.id = t.session_id;",
        "options": {}
      },
