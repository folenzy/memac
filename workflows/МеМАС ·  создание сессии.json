    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"ASiruk\".interview_sessions\n    (employee_id, or_id, duration_min, is_training, status)\nVALUES\n    ({{ $json.employee_id }}, {{ $json.or_id }}, {{ $json.duration_min }},\n     {{ $json.is_training }}, 'planned')\nRETURNING id AS session_id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        416,
        -16
      ],
      "id": "1b3bda23-6db7-4ffc-bfe4-c39a554c3928",
      "name": "создать сессию",
      "credentials": {
        "postgres": {
          "id": "KSlL0XgJe9oa85ah",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT question_id, competency_id, question_text\nFROM (\n  SELECT q.id AS question_id, q.competency_id, q.question_text,\n         row_number() OVER (PARTITION BY q.competency_id ORDER BY random()) AS rn\n  FROM \"ASiruk\".interview_questions q\n  WHERE q.competency_id = ANY(ARRAY[{{ $('Проверка входа').item.json.competency_ids_sql }}]::int[])\n    AND q.status = 'approved'\n) t\nWHERE rn <= {{ $('Проверка входа').item.json.per_competency }}\nORDER BY competency_id, rn;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        784,
        -16
      ],
      "id": "2bbd3307-ba9c-4ca2-9805-8a62a5dba196",
      "name": "отобрать вопросы",
      "credentials": {
        "postgres": {
          "id": "KSlL0XgJe9oa85ah",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const byComp = {};\nfor (const it of $input.all()) {\n  const k = it.json.competency_id;\n  if (!byComp[k]) byComp[k] = [];\n  byComp[k].push(it.json);\n}\n\nconst keys = Object.keys(byComp);\nconst ordered = [];\nlet idx = 0;\nlet more = true;\nwhile (more) {\n  more = false;\n  for (const k of keys) {\n    if (byComp[k][idx]) { ordered.push(byComp[k][idx]); more = true; }\n  }\n  idx = idx + 1;\n}\n\nif (ordered.length === 0) throw new Error('Нет одобренных вопросов по выбранным компетенциям');\n\nconst sessionId = $('2. Привязать компетенции').first().json.session_id;\nreturn ordered.map((o, i) => ({ json: {\n  session_id:    sessionId,\n  question_id:   o.question_id,\n  competency_id: o.competency_id,\n  order_no:      i + 1\n}}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -16
      ],
      "id": "fcc8c01f-a1cf-477a-8623-26cc433420d2",
      "name": "порядок вопросов"
    },
    {
      "parameters": {
        "jsCode": "let token = '';\nfor (let i = 0; i < 32; i++) token = token + Math.floor(Math.random() * 16).toString(16);\nreturn [{ json: {\n  session_id: $('2. Привязать компетенции').first().json.session_id,\n  token:      token,\n  questions:  $input.all().length\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1296,
        -16
      ],
      "id": "a80a47f9-56aa-4c38-a98d-44b7ff94428a",
      "name": "токены комнаты"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"ASiruk\".rooms (session_id, token, role, expires_at)\nVALUES ({{ $json.session_id }}, '{{ $json.token }}', 'employee', now() + interval '7 days')\nRETURNING session_id, token;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1472,
        -16
      ],
      "id": "aee7725f-86e9-4ae0-b367-38cf3912012e",
      "name": "создать комнату",
      "credentials": {
        "postgres": {
          "id": "KSlL0XgJe9oa85ah",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet b = raw.body;\nif (!b) b = raw;\n\nconst ids = [];\nif (Array.isArray(b.competency_ids)) {\n  for (const v of b.competency_ids) ids.push(Number(v));\n}\n\nlet dur = Number(b.duration_min);\nif (!dur) dur = 30;\n\nconst total = Math.max(6, Math.round(dur / 3));\nlet per = Math.ceil(total / Math.max(ids.length, 1));\nif (per < 2) per = 2;\n\nreturn [{ json: {\n  employee_id:        Number(b.employee_id),\n  or_id:              Number(b.or_id),\n  competency_ids:     ids,\n  competency_ids_sql: ids.join(','),\n  duration_min:       dur,\n  is_training:        b.is_training === true,\n  comp_count:         ids.length,\n  per_competency:     per\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        0
      ],
      "id": "2c520366-c067-4e26-8857-6ad83d4c3b14",
      "name": "Проверка входа"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (\n  INSERT INTO \"ASiruk\".session_competencies (session_id, competency_id)\n  SELECT {{ $json.session_id }},\n         unnest(ARRAY[{{ $('Проверка входа').item.json.competency_ids_sql }}]::int[])\n  ON CONFLICT DO NOTHING\n  RETURNING 1\n)\nSELECT {{ $json.session_id }} AS session_id, (SELECT count(*) FROM ins) AS linked;",
        "options": {}
      },
