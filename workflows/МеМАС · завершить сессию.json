      "name": "2. Ответы сессии",
      "credentials": {
        "postgres": {
          "id": "KSlL0XgJe9oa85ah",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const WORDS = ['зарплат', 'оклад', 'компенсац', 'вилк', 'з/п', 'зп ',\n               'сколько платят', 'деньг', 'доход', 'ставка', 'оффер'];\n\nconst rows = $input.all().map(i => i.json);\nconst flags = [];\n\nfor (const r of rows) {\n  const t = String(r.transcript || '').toLowerCase();\n  if (!t) continue;\n  for (const w of WORDS) {\n    if (t.indexOf(w) !== -1) {\n      const pos = t.indexOf(w);\n      let from = pos - 40;\n      if (from < 0) from = 0;\n      flags.push({\n        session_id: r.session_id,\n        answer_id:  r.answer_id,\n        flag_type:  'salary',\n        evidence:   String(r.transcript).slice(from, pos + 60)\n      });\n      break;\n    }\n  }\n}\n\nreturn [{ json: {\n  session_id: rows.length ? rows[0].session_id : null,\n  answers:    rows,\n  flags:      flags,\n  flag_count: flags.length\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "5660561a-1905-4bcb-b735-cabd2e8fc841",
      "name": "3. Красные флаги"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"ASiruk\".red_flags (session_id, answer_id, flag_type, evidence)\nSELECT (f->>'session_id')::int, (f->>'answer_id')::int,\n       f->>'flag_type', f->>'evidence'\nFROM jsonb_array_elements('{{ JSON.stringify($json.flags) }}'::jsonb) AS f\nRETURNING id;",
        "options": {}
      },
