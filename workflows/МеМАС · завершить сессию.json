    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id AS answer_id, a.audio_path, a.transcript,\n       {{ $json.session_id }} AS session_id\nFROM \"ASiruk\".session_answers a\nWHERE a.session_id = {{ $json.session_id }}\n  AND a.audio_path IS NOT NULL\nORDER BY a.id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
